# Set your Supabase PostgreSQL connection URI here (server only, NEVER client JS).
# Use the Session Pooler URI if direct PostgreSQL is unreachable (IPv4 networks).
SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
VELOUR_ADMIN_USER=admin
VELOUR_ADMIN_PASSWORD=CHOOSE_A_UNIQUE_STRONG_PASSWORD_12_PLUS
VELOUR_SECURE_COOKIES=1
